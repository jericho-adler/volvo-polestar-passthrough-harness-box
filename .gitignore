# KiCad automatic local-history snapshots (editor backups, not project source)
.history/

# Python bytecode cache
__pycache__/
*.pyc

# Local Claude Code session settings (machine-specific, not project source)
.claude/

# KiCad per-user local project state (view/window settings, not design source)
*.kicad_prl

# KiCad editor lock files (present only while a project is open)
~*.lck
